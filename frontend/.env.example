# Copy to .env.local and fill in. All values are public (they are bundled into the site) — never put secrets here.

# Public contact details (leave empty to hide them from the UI)
VITE_EMAIL=
VITE_GITHUB_URL=
VITE_LINKEDIN_URL=

# URL of the Java contact API (e.g. https://your-api.example.com). Leave empty to use the mailto fallback only.
VITE_API_URL=

# Only needed when hosting under a sub-path (GitHub Pages project site), e.g. /UknowMe/
VITE_BASE=/
